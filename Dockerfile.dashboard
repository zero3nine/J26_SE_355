FROM python:3.14-slim
WORKDIR /app
COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt \
    && useradd --create-home --uid 10001 dashboard
COPY --chown=dashboard:dashboard public_dashboard/__init__.py public_dashboard/app.py public_dashboard/data.py ./public_dashboard/
COPY --chown=dashboard:dashboard public_dashboard/static/ ./public_dashboard/static/
USER dashboard
ENV DASHBOARD_DB=/published/dashboard.sqlite3 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3)"
CMD ["gunicorn", "public_dashboard.app:application", "--bind", "0.0.0.0:8080", "--workers", "2", "--threads", "4", "--access-logfile", "-", "--error-logfile", "-"]
